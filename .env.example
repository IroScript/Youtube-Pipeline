# YouTube Automation Pipeline Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# ==============================================================================
# YouTube Data API v3 Credentials (OAuth 2.0)
# Obtain these from the Google Cloud Console (APIs & Services -> Credentials)
# ==============================================================================
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REFRESH_TOKEN=your-long-lived-oauth2-refresh-token

# Optional: Default Channel ID
YOUTUBE_CHANNEL_ID=

# ==============================================================================
# Database Configuration
# ==============================================================================
# SQLite Default (active):
DATABASE_URL=sqlite:///PromptDatabase/database/youtube_pipeline.db

# PostgreSQL (Optional - for future cloud clustering):
# POSTGRES_URL=postgresql://user:password@localhost:5432/youtube_pipeline

# ==============================================================================
# External LLM API Keys (Optional - for direct cloud prompt/SEO generation)
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
