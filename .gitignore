# ==========================================
# GitHub GitIgnore Rule for Youtube Pipeline
# ==========================================

# Ignore Large Audio & Video Render Outputs
*.mp3
*.wav
*.mp4
*.m4a
*.flac
*.aac
*.avi
*.mov
*.mkv
*.webm

# Ignore Python Caches & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Ignore Terminal Logs & Temp Files
*.log
.terminal-logs/
.agent/
.ds_store
Thumbs.db
*.tmp

# Ignore Large Model Cache Weights
.cache/
*.bin
*.pt
*.safetensors
*.pth
*.onnx

# Ignore API Keys & Secrets (NEVER push keys!)
**/NVIDIA NIM API KEY.txt
kaggle.json
Kagle API Key.txt
CWINDOWSsystem32cmd.exe*.txt
*.env
**/secrets/
**/api_keys/

# Ignore large zip/archive files
*.zip
*.tar.gz
*.rar

# Ignore test_push directory
kaggle video/test_push/

# Allow Git tracking of empty folder structures via .gitkeep
!.gitkeep
