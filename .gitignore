# ==========================================
# GitHub GitIgnore Rule for Youtube Pipeline
# ==========================================

# Ignore Large Audio & Video Render Outputs
*.mp3
*.wav
*.mp4
*.m4a
*.flac
*.aac
*.avi
*.mov
*.mkv
*.webm

# Ignore Python Caches & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Ignore Terminal Logs & Temp Files
*.log
.terminal-logs/
.agent/
.ds_store
Thumbs.db
*.tmp
_chrome_profile*/
**/_chrome_profile*/

# Ignore Large Model Cache Weights
.cache/
*.bin
*.pt
*.safetensors
*.pth
*.onnx

# Ignore API Keys & Secrets (NEVER push keys!)
**/NVIDIA NIM API KEY.txt
kaggle.json
Kagle API Key.txt
CWINDOWSsystem32cmd.exe*.txt
*.env
**/secrets/
**/api_keys/

# Ignore large zip/archive files
*.zip
*.tar.gz
*.rar

# Ignore test_push directory
kaggle video/test_push/

# Allow Git tracking of empty folder structures via .gitkeep
!.gitkeep

# Ignore API Keys
*API*Key*.txt
*API*KEY*.txt

# Ignore Node, Frontend Build & Automation Caches
node_modules/
.npm/
.pnpm-store/
dist/
build/
.vite/
.playwright/
.playwright-mcp/
playwright-report/
test-results/
.pytest_cache/
*.egg-info/
.claude/
.puku-cli/

# ==========================================
# Root archive/ folder is intentionally tracked & pushed.
# Un-ignore its text/log/CSV/image contents that the rules above would otherwise skip.
# (Secret-bearing logs are kept OUT of archive/ on purpose — do not add exceptions for keys.)
# ==========================================
!/archive/
!/archive/**/
!/archive/**/*.txt
!/archive/**/*.log
!/archive/**/*.csv
!/archive/**/*.png
!/archive/**/*.json
!/archive/**/*.md

# Re-ignore any secret or terminal dump files that might land in archive/
archive/*API*Key*.txt
archive/*API*KEY*.txt
archive/*Kagle*
archive/CWINDOWSsystem32cmd.exe*.txt

# YouTube API OAuth Secrets (NEVER push these)
client_secrets.json
client_secrets*.json
token.json
YoutubeAPI.txt
chatgpt_com_cookies.json
*google*client*id*
*google*client*secret*
*oauth_credentials*

# youtube-uploader local state (queue, uploaded, registry)
youtube-uploader-eval/state/
youtube-uploader-eval/queue/
youtube-uploader-eval/uploaded/
youtube-uploader-eval/logs/
youtube-uploader-eval/uv.lock
youtube-uploader-eval/test.mp4
