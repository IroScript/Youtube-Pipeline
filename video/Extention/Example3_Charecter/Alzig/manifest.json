{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "Alzig Flow Pro - Bulk Video Automation",
  "version": "2.3",
  "description": "Automate bulk AI video generation with Google Flow. Queue prompts, batch process, auto-download videos.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "sidePanel",
    "notifications",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://storage.googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://extensions.alzig.com/*",
    "https://alzig.com/*",
    "https://*.alzig.com/*"
  ],
  "oauth2": {
    "client_id": "949302495894-scon8v3oe8us7d7cnamndk9c92unn973.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.upload",
      "https://www.googleapis.com/auth/youtube.readonly"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow/*",
        "https://labs.google/fx/tools/flow/project/*"
      ],
      "js": [
        "utils/domHelpers.js",
        "utils/promptParser.js",
        "utils/flowSettings.js",
        "utils/extendMode.js",
        "content.js"
      ]
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Alzig Flow Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "utils/*.js",
        "youtube-auth.js",
        "youtube-upload.js",
        "metadata-generator.js"
      ],
      "matches": [
        "https://labs.google/*"
      ]
    }
  ]
}