{
  "manifest_version": 3,
  "name": "FlowCraft AI Studio - Google Flow Automation",
  "short_name": "FlowCraft AI",
  "description": "Professional bulk video and image automation studio for Google Flow & Google Labs. Batch generate media, auto-download in 4K/1080p, and chain story prompts.",
  "version": "1.0.0",
  "action": {
    "default_title": "FlowCraft AI Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://labs.google/*"
      ],
      "js": [
        "content/content-loader.js"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "offline_enabled": true,
  "host_permissions": [
    "*://labs.google/*"
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "sidePanel",
    "activeTab",
    "downloads",
    "scripting",
    "debugger"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://labs.google/*"
      ],
      "resources": [
        "shared/*",
        "content/*",
        "utils/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
